rules_version = '2';

// Seuls vos deux comptes peuvent lire et écrire.
// Remplacez les deux adresses par celles créées dans
// Firebase > Authentication > Utilisateurs.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email in [
          'premier.email@exemple.com',
          'second.email@exemple.com'
        ];
    }
  }
}
